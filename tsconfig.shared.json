{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Projects */
    "composite": true,
    "tsBuildInfoFile": "./.tsc-cache/shared/tsconfig.tsbuildinfo",

    /* Language and Environment */
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],

    /* Emit */
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./.tsc-cache/shared"
  },
  "include": ["app/shared/**/*.ts", "app/shared/**/*.tsx"],
  "exclude": ["**/*.spec.ts", "**/*.spec.tsx"]
}
