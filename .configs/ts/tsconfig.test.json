{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /* Projects */
    "composite": true,
    "tsBuildInfoFile": "../../.tsc-cache/test/tsconfig.tsbuildinfo",

    /* Language and Environment */
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],

    /* Emit */
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "../../.tsc-cache/test",
    "rootDir": "../.."
  },
  "include": [
    "../../.configs/**/*.ts",
    "../../**/*.spec.ts",
    "../../**/*.spec.tsx",
    "../../app/**/*.d.ts",
    "../../vitest.config.ts"
  ],
  "references": [
    { "path": "./tsconfig.server.json" },
    { "path": "./tsconfig.shared.json" }
  ]
}
