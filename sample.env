# ==============================================================================
# SERVER SETTINGS
# ==============================================================================

# Bind-all IPv4 address (use 0.0.0.0 to listen on all interfaces)
VITE_APP_BIND_ALL_IPV4=0.0.0.0

# Logging level for the application
# Options: debug, error, fatal, info, silent, trace, warn
# Default: info
VITE_APP_LOG_LEVEL=info

# IPv4 loopback address
VITE_APP_LOOPBACK_HOST_V4=127.0.0.1

# Dual-stack loopback address for IPv4/IPv6 compatibility
VITE_APP_LOOPBACK_HOST_V4_MAPPED=::ffff:127.0.0.1

# Port where the application will run (integer 1-65535)
VITE_APP_PORT=port-number

# Name of the service, used for logging and other purposes (non-empty string)
VITE_APP_SERVICE_NAME=service-name

# ==============================================================================
# AUTHENTICATION & ENCRYPTION
# ==============================================================================

# Secrets for authentication & encryption
# ⚠️ MUST be at least 88 characters and base64 (64 random bytes)
# ⚠️ Use a cryptographically random value; do not reuse across environments
# Generate with: $env:PATH += ";C:\Program Files\Git\usr\bin"; openssl rand -base64 64 | tr -d '\n'
VITE_APP_SHUTDOWN_TOKEN=replace-with-the-output-of-the-command-above

# ==============================================================================
# DEVELOPMENT SETTINGS (Development only, optional)
# ==============================================================================

# Enable development mode (true/false). Optional; defaults to false.
VITE_APP_IS_DEVELOPMENT=false
