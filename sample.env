# ==============================================================================
# SERVER SETTINGS
# ==============================================================================

# Name of the service, used for logging and other purposes (non-empty string)
VITE_APP_SERVICE_NAME=service-name

# Bind-all IPv4 address (use 0.0.0.0 to listen on all interfaces)
VITE_APP_BIND_ALL_IPV4=0.0.0.0

# Logging level for the application
# Options: debug, error, fatal, info, silent, trace, warn
# Default: info
VITE_APP_LOG_LEVEL=info

# Port the application listens on (integer 1-65535)
VITE_APP_PORT=port-number

# ==============================================================================
# DATABASE SETTINGS
# ==============================================================================

# Name of the db, used for logging and other purposes (non-empty string)
VITE_APP_DB_NAME=db-name

# Admin password for the gel_db container.
# docker-compose maps it into the container as GEL_SERVER_PASSWORD.
VITE_APP_DB_PASSWORD=your-password

# Host the database client connects to (e.g. localhost)
VITE_APP_DB_HOST=hostname-or-ip-address

# Host port the gel_db container is published on (it listens on 5656 internally)
VITE_APP_DB_PORT=port-number

# Branch the database client connects to (Gel's unit of schema/data isolation)
VITE_APP_DB_BRANCH=branch-name

# Client-side TLS verification mode
# Options: strict, no_host_verification, insecure
# Use insecure for local dev so the client accepts the self-signed cert
VITE_APP_DB_CLIENT_TLS_SECURITY=insecure

# Security mode the gel_db container enforces for incoming connections.
# docker-compose maps it into the container as GEL_SERVER_SECURITY.
# Options: strict, insecure_dev_mode. Use insecure_dev_mode for local dev only.
VITE_APP_DB_SERVER_SECURITY=insecure_dev_mode

# ==============================================================================
# AUTHENTICATION & ENCRYPTION
# ==============================================================================

# Secrets for authentication & encryption
# 🚧 MUST be a base64-encoded value of at least 64 cryptographically random bytes (88 characters long)
# Generate: node -e "console.log(require('node:crypto').randomBytes(64).toString('base64'))"
VITE_APP_SHUTDOWN_TOKEN=replace-with-the-output-of-the-command-above

# ==============================================================================
# DEVELOPMENT SETTINGS (Development only, optional)
# ==============================================================================

# Enable development mode (true/false). Optional; defaults to false.
VITE_APP_IS_DEVELOPMENT=false
