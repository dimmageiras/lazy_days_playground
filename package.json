{
  "name": "lazy_days_playground",
  "private": true,
  "type": "module",
  "scripts": {
    "clean:full": "pnpm clean --lockfile && pnpm store prune",
    "clean:install": "pnpm clean:full && pnpm i",
    "dev": "vite-node --config ./.configs/vite/server.config.ts --mode dev --watch ./app/server/start.ts",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 --rule \"no-console: ['error', { allow: ['error', 'info', 'warn'] }]\"",
    "lint:fix": "pnpm lint --fix",
    "obsolete": "knip",
    "pretest:pollution": "node --input-type=module -e \"import { mkdirSync } from 'node:fs'; mkdirSync('logs/unit-tests', { recursive: true });\"",
    "test": "pnpm --parallel --aggregate-output run \"/^test:(server|shared)$/\"",
    "test:cov": "pnpm --parallel run \"/^test:cov:(server|shared)$/\" && vitest run --merge-reports=logs/unit-tests-blob --coverage",
    "test:cov:server": "pnpm test:server --coverage --coverage.include='app/server/**/*.{ts,tsx}' --coverage.reportsDirectory=logs/unit-tests-coverage-server --reporter=blob --outputFile=logs/unit-tests-blob/server.json",
    "test:cov:shared": "pnpm test:shared --coverage --coverage.include='app/shared/**/*.{ts,tsx}' --coverage.reportsDirectory=logs/unit-tests-coverage-shared --reporter=blob --outputFile=logs/unit-tests-blob/shared.json",
    "test:pollution": "pnpm --parallel run \"/^test:pollution:(server|shared)$/\"",
    "test:pollution:server": "pnpm test:server --reporter=verbose --mode=debug > logs/unit-tests/pollution-probe.server.log 2>&1",
    "test:pollution:shared": "pnpm test:shared --reporter=verbose --mode=debug > logs/unit-tests/pollution-probe.shared.log 2>&1",
    "test:server": "vitest run --project server",
    "test:shared": "vitest run --project shared",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "axios": "1.18.1",
    "close-with-grace": "2.5.0",
    "dayjs": "1.11.21",
    "fastify": "5.9.0",
    "immutable": "5.1.9",
    "lodash-es": "4.18.1",
    "pid-port": "2.1.1",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/eslint-plugin-security": "3.0.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^26",
    "@typescript-eslint/parser": "8.62.1",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/spy": "4.1.9",
    "eslint": "9.39.4",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-sonarjs": "4.1.0",
    "globals": "17.7.0",
    "jiti": "2.7.0",
    "knip": "6.23.0",
    "pino-pretty": "13.1.3",
    "type-fest": "5.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.0",
    "vite-node": "6.0.0",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
